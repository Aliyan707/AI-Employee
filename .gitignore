# =============================================================================
# CS AI FTE — .gitignore
# Python + Node.js + Docker + K8s
# =============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
!.env.example
!.env.local.example
secrets/
*.pem
*.key
*.p12

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# pytest
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.log
coverage.xml
*.xml

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# --- Node.js / Next.js ---
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# --- Docker ---
.docker/

# --- Kubernetes secrets (never commit real values) ---
k8s/secret.yaml

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Test fixtures with real data ---
tests/fixtures/real_*

# --- Logs ---
*.log
logs/

# --- Compiled files ---
*.pyc
*.pyo
