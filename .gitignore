# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.pnpm-debug.log*
dist/
build/

# ============================================
# Environment & Secrets (CRITICAL)
# ============================================
.env
.env.*
!.env.example
*.env
credentials.json
token.pickle
gmail_token.pickle
whatsapp_session/
*.key
*.pem
*.crt
*.p12
*.pfx
config.secret.*
secrets/
*.secret.yaml

# ============================================
