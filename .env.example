# =============================================================================
# CS AI FTE — Environment Variables
# Copy this file to .env and fill in all values before running the application.
# NEVER commit .env to version control.
# =============================================================================

# --- OpenAI ---
# Required: Your OpenAI API key for GPT-4o and text-embedding-3-small calls
OPENAI_API_KEY=sk-...

# --- Gmail Integration ---
# Path to the Google service account JSON credentials file
GMAIL_CREDENTIALS_PATH=/secrets/gmail-credentials.json
# Gmail PubSub topic name for push notifications
GMAIL_TOPIC_NAME=projects/your-project/topics/gmail-push
# Gmail address that receives customer support emails
GMAIL_SUPPORT_ADDRESS=support@yourcompany.com

# --- Twilio / WhatsApp ---
# Twilio Account SID (found in Twilio Console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio Auth Token (used for HMAC-SHA1 webhook signature validation)
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio WhatsApp sender number (format: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cs_fte
POSTGRES_USER=cs_fte_user
POSTGRES_PASSWORD=change_me_in_production

# --- Kafka ---
# Comma-separated list of Kafka broker addresses
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Application ---
# Application secret key (used for signing internal tokens)
SECRET_KEY=change_me_to_a_random_32_char_string
# Environment: development | staging | production
ENVIRONMENT=development
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Hour (UTC, 0-23) to run daily report generation
DAILY_REPORT_HOUR=7

# --- Escalation ---
# Webhook URL where escalation events are POSTed to the human queue
# Example: a Zapier, Make.com, or internal webhook endpoint
ESCALATION_QUEUE_WEBHOOK=https://hooks.example.com/escalation

# --- Frontend ---
# URL of the FastAPI backend (used by Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
