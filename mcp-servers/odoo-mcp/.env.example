# Odoo MCP Server Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Odoo instance URL
ODOO_URL=http://localhost:8069

# Odoo database name
ODOO_DB=your_database_name

# Odoo username (must have accounting permissions)
ODOO_USERNAME=your_odoo_username

# Path to file containing Odoo password
# Create a text file with your password and reference it here
# Example: /home/user/.secrets/odoo_password.txt
ODOO_PASSWORD_FILE=/path/to/password_file.txt
