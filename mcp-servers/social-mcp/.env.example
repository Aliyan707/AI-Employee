# Social MCP Server — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# ── Vault ──────────────────────────────────────────────────────────────────────
VAULT_PATH=C:\Users\Cs\Desktop\AI Employee-

# ── Facebook (Meta Graph API) ──────────────────────────────────────────────────
# 1. Go to developers.facebook.com → Create App → Business type
# 2. Add "Facebook Login" + "Pages" products
# 3. Generate a Page Access Token with pages_manage_posts permission
FB_PAGE_ID=YOUR_FACEBOOK_PAGE_ID
FB_PAGE_ACCESS_TOKEN=YOUR_FACEBOOK_PAGE_ACCESS_TOKEN

# ── Instagram (Meta Graph API) ─────────────────────────────────────────────────
# Requires an Instagram Business or Creator account connected to a Facebook Page.
# 1. In your Meta App, add the Instagram Graph API product
# 2. Get your Instagram Business Account ID (IG_USER_ID)
# 3. Use the same long-lived Page Access Token or generate an IG token
IG_USER_ID=YOUR_INSTAGRAM_BUSINESS_USER_ID
IG_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN

# ── Twitter / X (API v2) ───────────────────────────────────────────────────────
# 1. Apply at developer.twitter.com (Free tier gives 1500 tweets/month)
# 2. Create a project + app with Read and Write permissions
# 3. Generate OAuth 1.0a User Access Tokens
TW_BEARER_TOKEN=YOUR_TWITTER_BEARER_TOKEN
TW_API_KEY=YOUR_TWITTER_API_KEY
TW_API_SECRET=YOUR_TWITTER_API_SECRET
TW_ACCESS_TOKEN=YOUR_TWITTER_ACCESS_TOKEN
TW_ACCESS_SECRET=YOUR_TWITTER_ACCESS_SECRET
