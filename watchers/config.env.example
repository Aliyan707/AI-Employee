# Silver-tier AI Employee - Watcher Configuration
# Copy this file to config.env and fill in your values
# NEVER commit config.env to version control!

# Vault Configuration
VAULT_PATH=/path/to/AI_Employee_Vault

# Gmail Watcher Configuration
GMAIL_CREDENTIALS_PATH=/path/to/gmail-credentials.json
GMAIL_TOKEN_PATH=/path/to/gmail-token.pickle

# File System Watcher Configuration
DROP_FOLDER_PATH=/path/to/drop-folder
COPY_FILES_TO_VAULT=true

# Watcher Check Intervals (seconds)
GMAIL_CHECK_INTERVAL=120
FILESYSTEM_CHECK_INTERVAL=0

# Logging
LOG_LEVEL=INFO
